# Customer 360 WooCommerce CRM Configuration

# Application
DATABASE_URL=sqlite:///./crm.db

# WooCommerce REST API v3 Integration (Optional - CRM runs in demo mode if empty)
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_TIMEOUT=15.0

# LLM & Agentic AI Configuration
# Provider options: openai, groq, openrouter, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
